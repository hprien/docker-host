{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "permission": {
    "bash": {
      "*": "ask"
    },
    "external_directory": "ask",
    "webfetch": "allow"
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 41111
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (docker)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "glm-5.3:cloud": {
          "name": "glm5.3:cloud",
          "limit": {
           "context": 1048576,
            "output": 128000
          }
        }
      }
    }
  }
}